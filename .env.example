# ─────────────────────────────────────────────────────────────────────────────
# TX-Observer | Environment Variables Template
#
# 使用方法：
#   cp .env.example .env
#   # 用文字編輯器開啟 .env，將所有 <...> 替換為你的真實金鑰
#
# 注意事項：
#   - 填好的 .env 已被 .gitignore 排除，絕對不會被 git commit
#   - 本檔案 (.env.example) 只含欄位名稱與說明，可安全提交至 GitHub
#   - 所有金鑰請妥善保管，勿截圖、勿貼入公開聊天室
# ─────────────────────────────────────────────────────────────────────────────


# ── Shioaji API (永豐金證券) ───────────────────────────────────────────────────
#
# 取得方式：
#   1. 前往 https://sinotrade.github.io/ 申請開通 API 權限
#   2. 登入永豐金 e-Leader → API 管理 → 建立金鑰
#   3. 取得 API Key 與 Secret Key（各約 44 字元）
#
SHIOAJI_API_KEY=<your_shioaji_api_key>
SHIOAJI_SECRET_KEY=<your_shioaji_secret_key>


# ── LINE Messaging API ────────────────────────────────────────────────────────
#
# 取得 LINE_CHANNEL_ACCESS_TOKEN：
#   1. 前往 https://developers.line.biz/ 建立 Messaging API Channel
#   2. Basic Settings → Channel Access Token → Issue（長效型 Token）
#   3. Token 為長字串（約 172 字元），以 Bearer 形式使用
#
# 取得 LINE_TARGET_ID：
#   1. 在 Channel 設定中啟用 Webhook
#   2. 將 Bot 加入目標 LINE 群組，或與目標用戶成為好友
#   3. 對 Bot 發送任意訊息，從 Webhook 事件中取得：
#        群組推播 → source.groupId（開頭為 C，共 33 字元）
#        個人推播 → source.userId （開頭為 U，共 33 字元）
#
LINE_CHANNEL_ACCESS_TOKEN=<your_line_channel_access_token>
LINE_TARGET_ID=<your_line_group_id_or_user_id>


# ── Imgbb Image Hosting ───────────────────────────────────────────────────────
#
# 取得方式：
#   1. 前往 https://imgbb.com/ 免費註冊帳號
#   2. 個人頁面 → API → 申請 API Key（32 字元十六進位字串）
#   3. 免費方案支援無限上傳，無頻寬費用
#
IMGBB_API_KEY=<your_imgbb_api_key>
